# Local dev only: copy to `.env` and fill in. `.env` is gitignored —
# API keys must never be committed.
#
# NOTE: Vite inlines VITE_* values into the client bundle at build time,
# so these are for local development only. Never ship a public build
# with a personal key baked in — long-term, keys move behind a DOGS API.
VITE_FREESOUND_API_KEY=
VITE_PIXABAY_API_KEY=
